; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Marlow Bay - Fable 5.2 GTA (High)"
run/main_scene="res://gta/scenes/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

Game="*res://gta/code/core/game.gd"
Data="*res://gta/code/core/data.gd"
Assets="*res://gta/code/core/assets.gd"
Sfx="*res://gta/code/audio/sfx.gd"
Fx="*res://gta/code/combat/fx.gd"
Wanted="*res://gta/code/police/wanted.gd"
SaveGame="*res://gta/code/save/save_game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicles"
3d_physics/layer_3="characters"
3d_physics/layer_4="props"
3d_physics/layer_5="triggers"
3d_physics/layer_6="ragdoll"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=2048
anti_aliasing/quality/msaa_3d=1
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.1, 1)

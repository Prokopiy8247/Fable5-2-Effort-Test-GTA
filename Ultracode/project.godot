; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Halcyon Bay - Free Roam (Fable 5.2 GTA Ultracode)"
config/description="Original missionless open-world sandbox. Godot 4.7 + Blender MCP benchmark."
run/main_scene="res://gta/scenes/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://gta/code/core/input_setup.gd"
EventBus="*res://gta/code/core/event_bus.gd"
Settings="*res://gta/code/core/settings.gd"
Registry="*res://gta/code/core/registry.gd"
Game="*res://gta/code/core/game.gd"
WorldClock="*res://gta/code/world/world_clock.gd"
Weather="*res://gta/code/world/weather.gd"
Audio="*res://gta/code/audio/audio_manager.gd"
Fx="*res://gta/code/combat/fx.gd"
Wanted="*res://gta/code/police/wanted_system.gd"
Skills="*res://gta/code/player/skills.gd"
SaveSystem="*res://gta/code/save/save_system.gd"
UI="*res://gta/code/ui/ui_manager.gd"
TestHarness="*res://gta/code/debug/test_harness.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[filesystem]

import/blender/enabled=false

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="NPC"
3d_physics/layer_4="Vehicle"
3d_physics/layer_5="Prop"
3d_physics/layer_6="Trigger"
3d_physics/layer_7="Projectile"
3d_physics/layer_8="Water"
3d_physics/layer_9="Hitbox"
3d_physics/layer_10="Ragdoll"
3d_physics/layer_11="Cover"
3d_physics/layer_12="Climb"
3d_physics/layer_13="Sensor"
3d_physics/layer_14="Pickup"
3d_physics/layer_15="Glass"
3d_physics/layer_16="Debris"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=false

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.45, 0.62, 0.78, 1)
occlusion_culling/use_occlusion_culling=true

[shader_globals]

gta_daylight={
"type": "float",
"value": 1.0
}
gta_night={
"type": "float",
"value": 0.0
}
gta_wetness={
"type": "float",
"value": 0.0
}
gta_rain={
"type": "float",
"value": 0.0
}
gta_time={
"type": "float",
"value": 0.0
}
gta_underwater={
"type": "float",
"value": 0.0
}
gta_wind={
"type": "vec3",
"value": Vector3(1, 0, 0.3)
}
gta_player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Port Cinder — Fable 5.2 GTA (Medium)"
run/main_scene="res://gta/scenes/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

G="*res://gta/code/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=14.0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicles"
3d_physics/layer_3="characters"
3d_physics/layer_4="props"
3d_physics/layer_5="triggers"

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=1024
anti_aliasing/quality/screen_space_aa=1
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.5, 0.7, 0.9, 1)
